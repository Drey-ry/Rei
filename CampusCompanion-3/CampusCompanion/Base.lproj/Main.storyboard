                            <constraint firstItem="NameField-1" firstAttribute="leading" secondItem="RootSafe-1" secondAttribute="leading" constant="32" id="NameLead"/>
                            <constraint firstItem="NameField-1" firstAttribute="trailing" secondItem="RootSafe-1" secondAttribute="trailing" constant="-32" id="NameTrail"/>
                            <constraint firstItem="NotifyLabel-1" firstAttribute="top" secondItem="NameField-1" secondAttribute="bottom" constant="12" id="NotifyLabelTop"/>
                            <constraint firstItem="NotifyLabel-1" firstAttribute="leading" secondItem="NameField-1" secondAttribute="leading" id="NotifyLabelLead"/>
