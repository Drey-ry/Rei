                                <constraints><constraint firstAttribute="height" constant="44" id="NameHeight-1"/></constraints>
                            </textField>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Notify me about events" translatesAutoresizingMaskIntoConstraints="NO" id="NotifyLabel-1">
                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                            </label>
                            <switch opaque="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="NotifySwitch-1"/>
                            <segmentedControl opaque="NO" contentMode="scaleToFill" selectedSegmentIndex="0" translatesAutoresizingMaskIntoConstraints="NO" id="RoleSegments-1">
                                <segments><segment title="Student"/><segment title="Faculty"/></segments>
                            </segmentedControl>
                            <datePicker opaque="NO" contentMode="scaleToFill" datePickerMode="date" translatesAutoresizingMaskIntoConstraints="NO" id="DatePicker-1"/>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Guests" translatesAutoresizingMaskIntoConstraints="NO" id="GuestsLabel-1">
