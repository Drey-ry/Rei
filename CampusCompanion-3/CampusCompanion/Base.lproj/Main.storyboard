                                <buttonConfiguration key="configuration" style="filled" title="Explore Campus"/>
                                <connections><action selector="exploreButtonTapped:" destination="Root-1" eventType="touchUpInside" id="ExploreAction-1"/></connections>
                            </button>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="AnnouncementsButton-1">
                                <buttonConfiguration key="configuration" style="tinted" title="Campus Announcements"/>
