                                        <constraint firstItem="CategoryIcon-1" firstAttribute="width" constant="32" id="CellIconWidth"/>
                                        <constraint firstItem="CategoryIcon-1" firstAttribute="height" constant="32" id="CellIconHeight"/>
                                        <constraint firstItem="CellTitle-1" firstAttribute="leading" secondItem="CategoryIcon-1" secondAttribute="trailing" constant="16" id="CellTitleLead"/>
                                        <constraint firstItem="CellTitle-1" firstAttribute="trailing" secondItem="AnnouncementContent-1" secondAttribute="trailing" constant="-16" id="CellTitleTrail"/>
                                        <constraint firstItem="CellTitle-1" firstAttribute="top" secondItem="AnnouncementContent-1" secondAttribute="top" constant="12" id="CellTitleTop"/>
                                        <constraint firstItem="CellDate-1" firstAttribute="leading" secondItem="CellTitle-1" secondAttribute="leading" id="CellDateLead"/>
