                            <constraint firstItem="GuestsLabel-1" firstAttribute="top" secondItem="DatePicker-1" secondAttribute="bottom" constant="6" id="GuestsLabelTop"/>
                            <constraint firstItem="GuestsLabel-1" firstAttribute="leading" secondItem="NameField-1" secondAttribute="leading" id="GuestsLabelLead"/>
                            <constraint firstItem="GuestsStepper-1" firstAttribute="centerY" secondItem="GuestsLabel-1" secondAttribute="centerY" id="GuestsStepperCenter"/>
                            <constraint firstItem="GuestsStepper-1" firstAttribute="trailing" secondItem="NameField-1" secondAttribute="trailing" id="GuestsStepperTrail"/>
